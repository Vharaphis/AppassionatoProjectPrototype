[gd_resource type="Resource" script_class="CardData" format=3 uid="uid://wa5vq3it036t"]

[ext_resource type="Script" uid="uid://v3hbk2005353" path="res://scripts/data/card_data.gd" id="1_card_data"]
[ext_resource type="Script" uid="uid://drcxodvl17073" path="res://scripts/effects/card_effect.gd" id="2_card_effect"]
[ext_resource type="Script" uid="uid://kcxgswjg7rem" path="res://scripts/effects/damage_effect.gd" id="3_damage"]
[ext_resource type="Script" uid="uid://trtob8glpfvl" path="res://scripts/effects/circle_targets.gd" id="4_circle"]
[ext_resource type="Script" uid="uid://cfnlmhnlfi3r8" path="res://scripts/effects/keywords/keyword_effect.gd" id="5_keyword"]
[ext_resource type="Script" uid="uid://bsnstfi6gsn5c" path="res://scripts/effects/keywords/berserk_condition.gd" id="6_berserk"]
[ext_resource type="Script" uid="uid://pc7nbd5p0r4f" path="res://scripts/effects/slow_effect.gd" id="7_slow"]

[sub_resource type="Resource" id="Resource_growl_circle"]
script = ExtResource("4_circle")

[sub_resource type="Resource" id="Resource_growl_damage"]
script = ExtResource("3_damage")
amount = 5
targets = SubResource("Resource_growl_circle")

[sub_resource type="Resource" id="Resource_growl_berserk"]
script = ExtResource("6_berserk")

[sub_resource type="Resource" id="Resource_growl_slow"]
script = ExtResource("7_slow")
targets = SubResource("Resource_growl_circle")

[sub_resource type="Resource" id="Resource_growl_keyword"]
script = ExtResource("5_keyword")
condition = SubResource("Resource_growl_berserk")
text = "ralentit les cibles touchées pendant 2 s."
effects = Array[ExtResource("2_card_effect")]([SubResource("Resource_growl_slow")])

[resource]
script = ExtResource("1_card_data")
card_name = "Growl"
rarity = 1
cost = 2
description = "5 dégâts autour du joueur."
effects = Array[ExtResource("2_card_effect")]([SubResource("Resource_growl_damage"), SubResource("Resource_growl_keyword")])
