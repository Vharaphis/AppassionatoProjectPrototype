[sub_resource type="Resource" id="Resource_dash_effect"]
script = ExtResource("7_dash")
on_end = Array[ExtResource("2_card_effect")]([SubResource("Resource_dash_keyword")])

[resource]
script = ExtResource("1_card_data")
card_name = "Dash"
type = 1
rarity = 1
cost = 1
temporality = "xo"
description = "Ruée de 4 m vers la souris, invulnérable pendant la ruée."
effects = Array[ExtResource("2_card_effect")]([SubResource("Resource_dash_effect")])
