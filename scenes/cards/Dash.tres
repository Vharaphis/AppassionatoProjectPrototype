[sub_resource type="Resource" id="Resource_dash_berserk"]
script = ExtResource("6_berserk")

[sub_resource type="Resource" id="Resource_dash_circle"]
script = ExtResource("4_circle")
radius = 2.0

[sub_resource type="Resource" id="Resource_dash_shockwave"]
script = ExtResource("3_damage")
amount = 3
targets = SubResource("Resource_dash_circle")

[sub_resource type="Resource" id="Resource_dash_keyword"]
script = ExtResource("5_keyword")
