[ext_resource type="Script" uid="uid://bsnstfi6gsn5c" path="res://scripts/effects/keywords/berserk_condition.gd" id="5_berserk"]

[sub_resource type="Resource" id="Resource_fil_berserk"]
script = ExtResource("5_berserk")

[sub_resource type="Resource" id="Resource_fil_armor"]
script = ExtResource("3_sur_le_fil")
