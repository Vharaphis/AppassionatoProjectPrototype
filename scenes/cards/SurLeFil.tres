[gd_resource type="Resource" script_class="CardData" format=3 uid="uid://cg166gyy0g2p6"]

[ext_resource type="Script" uid="uid://v3hbk2005353" path="res://scripts/data/card_data.gd" id="1_card_data"]
[ext_resource type="Script" uid="uid://drcxodvl17073" path="res://scripts/effects/card_effect.gd" id="2_card_effect"]
[ext_resource type="Script" uid="uid://bowdo2sj6g042" path="res://scripts/effects/sur_le_fil_effect.gd" id="3_sur_le_fil"]
